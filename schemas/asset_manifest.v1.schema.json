{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxelcharacterfactory.dev/schemas/asset_manifest.v1.schema.json",
  "title": "Voxel Character Factory Asset Manifest Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_schema_version", "assets"],
  "properties": {
    "catalog_schema_version": {"const": 1},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "coordinate_map": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/safe_id"},
      "additionalProperties": {"$ref": "#/$defs/vector3"}
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "asset_id",
        "version",
        "kind",
        "source_path",
        "format",
        "semantic_tags",
        "compatible_bases",
        "pivots",
        "palette_roles",
        "author",
        "license",
        "provenance",
        "source_sha256",
        "thumbnail_path"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "asset_id": {"$ref": "#/$defs/safe_id"},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "kind": {"enum": ["body_part", "hair", "garment", "accessory", "weapon"]},
        "source_path": {"type": "string", "minLength": 1},
        "format": {"enum": ["vox", "glb", "gltf", "fbx", "obj"]},
        "semantic_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        },
        "compatible_bases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        },
        "pivots": {
          "allOf": [
            {"$ref": "#/$defs/coordinate_map"},
            {"minProperties": 1}
          ]
        },
        "sockets": {"$ref": "#/$defs/coordinate_map"},
        "palette_roles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/safe_id"}
        },
        "author": {"type": "string", "minLength": 1},
        "license": {"enum": ["CC0-1.0", "CC-BY-4.0"]},
        "provenance": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "thumbnail_path": {"type": "string", "minLength": 1},
        "placement_voxels": {"$ref": "#/$defs/vector3"},
        "scale_metadata": {"type": "object"},
        "notes": {"type": "string"}
      }
    }
  }
}
