{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxelcharacterfactory.dev/schemas/job.v2.schema.json",
  "title": "Voxel Character Factory Job v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "game", "role", "body_template", "rig_template", "animation_profile", "source"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "game": {"type": "string", "minLength": 1},
    "role": {"enum": ["hero", "villain", "support", "boss"]},
    "body_template": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "rig_template": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "animation_profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "weapon": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["proxy", "model", "assembly"]},
        "path": {"type": "string"},
        "asset_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "asset_assembly": {"type": "string"},
    "variant_of": {"type": "string"},
    "part_overrides": {"type": "object", "additionalProperties": {"type": "string"}},
    "animation_packs": {"type": "array", "items": {"type": "string"}},
    "export_profile": {"type": "string"},
    "target_height_meters": {"type": "number", "exclusiveMinimum": 0},
    "settings_overrides": {"type": "object"},
    "height_voxels": {"type": "integer", "minimum": 16, "maximum": 128},
    "palette_profile": {"type": "string"},
    "accent_colors": {"type": "array", "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
    "export_formats": {"type": "array", "items": {"enum": ["glb", "fbx"]}, "uniqueItems": true, "minItems": 1},
    "render_profile": {"type": "string"},
    "render_resolution": {"type": "integer", "minimum": 64, "maximum": 4096},
    "notes": {"type": "string"}
  }
}
