{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxelcharacterfactory.dev/schemas/job.v2.schema.json",
  "title": "Voxel Character Factory Job v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "game", "role", "body_template", "rig_template", "animation_profile", "source"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "game": {"type": "string", "minLength": 1},
    "role": {"enum": ["hero", "villain", "support", "boss"]},
    "body_template": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "rig_template": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "animation_profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "weapon": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["proxy", "model", "assembly"]},
        "path": {"type": "string"},
        "asset_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"}, "minItems": 1, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "proxy"}}}, "then": {"not": {"anyOf": [{"required": ["path"]}, {"required": ["asset_ids"]}]}}},
        {"if": {"properties": {"mode": {"const": "model"}}}, "then": {"required": ["path"], "not": {"required": ["asset_ids"]}}},
        {"if": {"properties": {"mode": {"const": "assembly"}}}, "then": {"required": ["asset_ids"], "not": {"required": ["path"]}}}
      ]
    },
    "asset_assembly": {"type": "string"},
    "variant_of": {"type": "string"},
    "part_overrides": {
      "type": "object",
      "propertyNames": {"enum": ["head", "torso", "pelvis", "upper_arm_l", "upper_arm_r", "lower_arm_l", "lower_arm_r", "hand_l", "hand_r", "upper_leg_l", "upper_leg_r", "lower_leg_l", "lower_leg_r", "foot_l", "foot_r", "hair", "coat", "cape", "cloth", "glove_l", "glove_r", "boot_l", "boot_r", "pauldron_l", "pauldron_r", "weapon", "shield", "accessory"]},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "animation_packs": {"type": "array", "items": {"type": "string"}},
    "export_profile": {"type": "string"},
    "target_height_meters": {"type": "number", "exclusiveMinimum": 0},
    "settings_overrides": {
      "type": "object",
      "properties": {
        "vox_meshing_mode": {"enum": ["greedy", "surface", "cubes"]},
        "limb_length_overrides": {
          "type": "object",
          "propertyNames": {"enum": ["upper_arm.L", "upper_arm.R", "forearm.L", "forearm.R", "hand.L", "hand.R", "thigh.L", "thigh.R", "shin.L", "shin.R", "foot.L", "foot.R"]},
          "additionalProperties": {"type": "number", "minimum": 0.5, "maximum": 1.5}
        }
      },
      "additionalProperties": true
    },
    "height_voxels": {"type": "integer", "minimum": 16, "maximum": 128},
    "palette_profile": {"type": "string"},
    "accent_colors": {"type": "array", "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
    "export_formats": {"type": "array", "items": {"enum": ["glb", "fbx"]}, "uniqueItems": true, "minItems": 1},
    "render_profile": {"type": "string"},
    "render_resolution": {"type": "integer", "minimum": 64, "maximum": 4096},
    "notes": {"type": "string"}
  }
}
