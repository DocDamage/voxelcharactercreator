{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxelcharacterfactory.dev/schemas/advanced_rig.v1.schema.json",
  "title": "Advanced Topology Rig v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "topology",
    "required_roles",
    "bones",
    "role_bones",
    "sockets",
    "engine_checks",
    "max_bones",
    "fallback_template"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "template_id": {"$ref": "#/$defs/safe_id"},
    "topology": {"enum": ["quadruped", "flying", "multi_arm", "boss"]},
    "required_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safe_id"}
    },
    "bones": {
      "type": "object",
      "minProperties": 1,
      "required": ["root"],
      "propertyNames": {"$ref": "#/$defs/safe_id"},
      "properties": {
        "root": {"type": "null"}
      },
      "additionalProperties": {
        "anyOf": [
          {"$ref": "#/$defs/safe_id"},
          {"type": "null"}
        ]
      }
    },
    "role_bones": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/safe_id"},
      "additionalProperties": {"$ref": "#/$defs/safe_id"}
    },
    "sockets": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/safe_id"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bone", "offset"],
        "properties": {
          "bone": {"$ref": "#/$defs/safe_id"},
          "offset": {"$ref": "#/$defs/vector3"}
        }
      }
    },
    "engine_checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["parts", "rig", "animation", "export", "godot"]}
    },
    "max_bones": {"type": "integer", "minimum": 1, "maximum": 256},
    "fallback_template": {"$ref": "#/$defs/safe_id"}
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
