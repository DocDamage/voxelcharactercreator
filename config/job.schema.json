{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxel Character Factory Job",
  "type": "object",
  "required": [
    "id",
    "name",
    "game",
    "role",
    "body_template",
    "rig_template",
    "animation_profile"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "game": {
      "type": "string"
    },
    "role": {
      "enum": [
        "hero",
        "villain",
        "support",
        "boss"
      ]
    },
    "source_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "export_formats": {
      "type": "array",
      "items": {
        "enum": [
          "glb",
          "fbx"
        ]
      }
    }
  }
}